# Email notification credentials — AWS SES SMTP (shared wehoware account,
# same credentials as Book & Block admin APIs). EMAIL_USER/PASS are the SES
# SMTP key pair, not an email address.
SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="RapidFix Website <no-reply@bookandblock.com>"
EMAIL_TO=Info@rapidfixauto.ca

# To use Gmail instead, omit SMTP_HOST/SMTP_PORT and set
# EMAIL_USER/EMAIL_PASS to a Gmail address + app password.

# Shopmonkey lead diversion — create key in Shopmonkey:
# Settings -> Integrations -> API Keys
SHOPMONKEY_API_KEY=
# Optional overrides (defaults shown):
# SHOPMONKEY_API_BASE=https://api.shopmonkey.cloud/v3
# SHOPMONKEY_LOCATION_ID=f3173cde-af0b-453f-93bd-1dbf406b64d0
